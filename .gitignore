# ------------------------------------------
# 1. Python cache and compiled files
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# ------------------------------------------
# 2. Python virtual environments
# ------------------------------------------
.venv/
venv/
env/
ml_ids_venv/

# ------------------------------------------
# 3. Environment variables and secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ------------------------------------------
# 4. Original and processed datasets
# ------------------------------------------
data/
*.parquet
*.pcap
*.pcapng

# ------------------------------------------
# 5. Generated prediction exports
# ------------------------------------------
exports/

# ------------------------------------------
# 6. Trained machine learning models
# ------------------------------------------
models/*.joblib
models/*.pkl
models/*.pickle

# ------------------------------------------
# 7. Day 15 experimental model
# ------------------------------------------
experiments/day15/experimental_xgboost.json

# Keep these Day 15 research outputs trackable:
# independent_validation.py
# validation_metrics.csv
# confusion_matrix.png
# classification_report.txt
# experiment_summary.json

